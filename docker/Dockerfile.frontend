FROM node:20-alpine AS builder

WORKDIR /app

COPY src/frontend/package.json src/frontend/package-lock.json ./

RUN npm ci

COPY src/frontend/ .

RUN npm run build

FROM node:20-alpine

WORKDIR /app

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000

ENV HOSTNAME=0.0.0.0

CMD ["node", "server.js"]

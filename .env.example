# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autism_tracker

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Extraction Provider (temporary_llm=Anthropic, ollama=local OpenAI-compatible endpoint, finetuned_model=stub)
EXTRACTION_PROVIDER=ollama
ANTHROPIC_API_KEY=your-anthropic-api-key

# Ollama / OpenAI-compatible endpoint (used by EXTRACTION_PROVIDER=ollama and
# REPORTING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.2:latest

# Reporting LLM (anthropic or ollama)
REPORTING_PROVIDER=ollama

# Application
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Data Pipeline
DATA_RAW_DIR=data/raw
DATA_OUTPUT_DIR=data/output

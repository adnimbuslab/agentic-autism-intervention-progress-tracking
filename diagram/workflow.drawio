        <mxCell id="lane3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#DFE1E6;fontColor=#344563;fontStyle=1;fontSize=14;align=left;spacingLeft=18;arcSize=12;" value="3  GOVERNED ANALYTICS &amp; REVIEW" vertex="1">
          <mxGeometry height="42" width="450" x="1080" y="130" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9AFF;strokeWidth=2;fontSize=14;align=left;verticalAlign=middle;spacing=14;arcSize=10;shadow=1;" value="&lt;b&gt;1. Professional setup&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#5E6C84&#39;&gt;Child workspace • goals &amp;amp; indicators • review period&lt;br&gt;contributors • settings • observation schedules&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="410" x="90" y="200" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9AFF;strokeWidth=2;fontSize=14;align=left;verticalAlign=middle;spacing=14;arcSize=10;shadow=1;" value="&lt;b&gt;2. Distributed observation&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#5E6C84&#39;&gt;Authorized contributors submit observations in context.&lt;br&gt;Overdue expectations surface as missing evidence.&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="410" x="90" y="345" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36B37E;strokeWidth=2;fontSize=14;align=left;verticalAlign=middle;spacing=14;arcSize=10;shadow=1;" value="&lt;b&gt;3. Conversational capture&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#5E6C84&#39;&gt;Natural-language observation stored with app-known child,&lt;br&gt;role, date, session, setting, and goal context.&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="410" x="90" y="490" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00A3BF;strokeWidth=2;fontSize=14;align=left;verticalAlign=middle;spacing=14;arcSize=10;shadow=1;" value="&lt;b&gt;4. Qwen 2.5 7B proposes structure&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#5E6C84&#39;&gt;Model fills supported fields and may ask a focused clarification&lt;br&gt;only when a missing detail is recoverable.&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="410" x="595" y="200" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#FFAB00;strokeWidth=2;fontSize=14;align=left;verticalAlign=middle;spacing=14;arcSize=10;shadow=1;" value="&lt;b&gt;5. Deterministic validation&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#5E6C84&#39;&gt;Code checks schema, allowed values, provenance,&lt;br&gt;and explicit null / unknown states.&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="410" x="595" y="345" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#FF5630;strokeWidth=2;fontSize=14;align=left;verticalAlign=middle;spacing=14;arcSize=10;shadow=1;" value="&lt;b&gt;6. Mandatory professional verification&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#5E6C84&#39;&gt;Intervention specialist compares proposal with source and&lt;br&gt;verifies, corrects, or rejects it.&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="410" x="595" y="490" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFFFF4;strokeColor=#36B37E;strokeWidth=2;fontSize=14;align=left;verticalAlign=middle;spacing=14;arcSize=10;shadow=1;" value="&lt;b&gt;7. Versioned evidence store&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#5E6C84&#39;&gt;Original source remains immutable; verified/corrected versions&lt;br&gt;and audit history stay linked.&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="410" x="595" y="635" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#FFAB00;strokeWidth=2;fontSize=14;align=left;verticalAlign=middle;spacing=14;arcSize=10;shadow=1;" value="&lt;b&gt;8. Adequacy &amp;amp; representation routing&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#5E6C84&#39;&gt;Coverage, time, contributor roles, settings, goal-domain coverage,&lt;br&gt;and completeness determine what may be analyzed.&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="410" x="1100" y="200" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00A3BF;strokeWidth=2;fontSize=14;align=left;verticalAlign=middle;spacing=14;arcSize=10;shadow=1;" value="&lt;b&gt;9. Deterministic analytics or abstention&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#5E6C84&#39;&gt;Eligible KPIs are computed by code; unsupported analyses&lt;br&gt;are withheld with a reason.&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="410" x="1100" y="345" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9AFF;strokeWidth=2;fontSize=14;align=left;verticalAlign=middle;spacing=14;arcSize=10;shadow=1;" value="&lt;b&gt;10. Professional dashboard &amp;amp; report&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#5E6C84&#39;&gt;Evidence, warnings, KPIs, withheld states, and source drill-down&lt;br&gt;are presented together.&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="410" x="1100" y="490" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9AFF;strokeWidth=2;fontSize=14;align=left;verticalAlign=middle;spacing=14;arcSize=10;shadow=1;" value="&lt;b&gt;11. Specialist interpretation &amp;amp; next review&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#5E6C84&#39;&gt;Professional decides what the evidence means and whether goals&lt;br&gt;or strategies continue, change, pause, or end.&lt;/font&gt;" vertex="1">

        </mxCell>
        <mxCell id="lane1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FF;strokeColor=#D6E4FF;fontColor=#0747A6;fontStyle=1;fontSize=14;align=left;spacingLeft=18;arcSize=12;" value="1  SETUP &amp; EVIDENCE CAPTURE" vertex="1">

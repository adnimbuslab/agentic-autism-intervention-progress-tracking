        </mxCell>
        <mxCell id="lane2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FBFC;strokeColor=#B3E5EA;fontColor=#006B76;fontStyle=1;fontSize=14;align=left;spacingLeft=18;arcSize=12;" value="2  AI STRUCTURING &amp; VALIDATION" vertex="1">

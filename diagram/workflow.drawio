        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#5E6C84;" value="Human-led evidence workflow • AI assists with structure and organization • intervention specialist retains decision authority" vertex="1">

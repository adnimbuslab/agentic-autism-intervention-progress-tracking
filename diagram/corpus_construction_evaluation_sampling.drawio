<mxfile host="app.diagrams.net" modified="2026-10-03T16:00:00.000Z" agent="ChatGPT" version="24.7.17"><diagram id="corpus-flow" name="Page-1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Corpus construction, reference finalization, and evaluation sampling" style="text;html=1;align=center;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#123F5F;" vertex="1" parent="1"><mxGeometry x="150" y="10" width="1300" height="45" as="geometry"/></mxCell>
<mxCell id="source" value="<b><font color="#164A6B" style="font-size:18px">Source data</font></b><br><br><font color="#263746" style="font-size:14px">11 children | 85 sessions | 75,003 utterances</font>" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;strokeColor=#164A6B;strokeWidth=2.5;fillColor=#F1F6F9;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="55" width="760" height="80" as="geometry"/></mxCell><mxCell id="episode" value="<b><font color="#687D8C" style="font-size:18px">Deterministic episode construction</font></b><br><br><font color="#263746" style="font-size:14px">9,018 behavioral episodes | 2–8 turns</font>" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;strokeColor=#687D8C;strokeWidth=2.5;fillColor=#F7F8F9;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="305" y="160" width="730" height="72" as="geometry"/></mxCell><mxCell id="mainhdr" value="MAIN EVALUATION" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#123F5F;" vertex="1" parent="1"><mxGeometry x="135" y="250" width="300" height="35" as="geometry"/></mxCell><mxCell id="frozenhdr" value="SEPARATELY FROZEN EVALUATION" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#178A98;" vertex="1" parent="1"><mxGeometry x="850" y="250" width="470" height="35" as="geometry"/></mxCell><mxCell id="balanced" value="<b><font color="#164A6B" style="font-size:18px">Balanced annotation universe</font></b><br><br><font color="#263746" style="font-size:14px">273/child ceiling → 2,442</font>" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;strokeColor=#164A6B;strokeWidth=2.5;fillColor=#F1F6F9;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="295" width="405" height="75" as="geometry"/></mxCell><mxCell id="seeded" value="<b><font color="#164A6B" style="font-size:18px">Seeded pool</font></b><br><br><font color="#263746" style="font-size:14px">120/child → 1,320 | seed 42 + child ID</font>" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;strokeColor=#164A6B;strokeWidth=2.5;fillColor=#F1F6F9;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="405" height="75" as="geometry"/></mxCell><mxCell id="batch" value="<b><font color="#164A6B" style="font-size:18px">Model-conditioned main batch</font></b><br><br><font color="#263746" style="font-size:14px">506 examined → 330 retained | 30/child</font>" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;strokeColor=#164A6B;strokeWidth=2.5;fillColor=#F1F6F9;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="505" width="405" height="75" as="geometry"/></mxCell><mxCell id="refdev" value="<b><font color="#164A6B" style="font-size:18px">Reference-standard development</font></b><br><br><font color="#263746" style="font-size:14px">Independent annotation → codebook clarification<br>→ re-annotation of 178 → consensus</font>" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;strokeColor=#164A6B;strokeWidth=2.5;fillColor=#F1F6F9;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="610" width="405" height="95" as="geometry"/></mxCell><mxCell id="audit" value="<b><font color="#C3423F" style="font-size:18px">Final-codebook compliance audit</font></b><br><br><font color="#263746" style="font-size:14px">Model-blind joint specialist review of 152 unreissued segments<br>456 targeted labels checked | 98 labels changed in 85 segments</font>" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;strokeColor=#C3423F;strokeWidth=2.5;fillColor=#FCEEEE;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="735" width="405" height="105" as="geometry"/></mxCell><mxCell id="postref" value="<b><font color="#278A58" style="font-size:18px">Post-compliance-audit reference</font></b><br><br><font color="#263746" style="font-size:14px">330 segments | used for final main-batch scoring</font>" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;strokeColor=#278A58;strokeWidth=2.5;fillColor=#EEF8F1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="870" width="405" height="75" as="geometry"/></mxCell><mxCell id="higher" value="<b><font color="#178A98" style="font-size:18px">Higher-cap universe</font></b><br><br><font color="#263746" style="font-size:14px">455/child ceiling → 3,371</font>" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;strokeColor=#178A98;strokeWidth=2.5;fillColor=#EAF8FA;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="295" width="405" height="75" as="geometry"/></mxCell><mxCell id="exclude" value="<b><font color="#178A98" style="font-size:18px">Identifier-based pool exclusion</font></b><br><br><font color="#263746" style="font-size:14px">3,371 − 1,320 IDs → 2,051 ID-eligible</font>" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;strokeColor=#178A98;strokeWidth=2.5;fillColor=#EAF8FA;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="400" width="405" height="75" as="geometry"/></mxCell><mxCell id="frozen" value="<b><font color="#178A98" style="font-size:18px">Original frozen evaluation set</font></b><br><br><font color="#263746" style="font-size:14px">132 retained | 12/child | seed 20260916</font>" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;strokeColor=#178A98;strokeWidth=2.5;fillColor=#EAF8FA;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="505" width="405" height="75" as="geometry"/></mxCell><mxCell id="frameaudit" value="<b><font color="#C3423F" style="font-size:18px">Stable-identity frame audit</font></b><br><br><font color="#263746" style="font-size:14px">136 pool retained / 136 non-pool excluded<br>11/132 frozen episodes overlap the pool</font>" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;strokeColor=#C3423F;strokeWidth=2.5;fillColor=#FCEEEE;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="610" width="405" height="95" as="geometry"/></mxCell><mxCell id="postanalysis" value="<b><font color="#278A58" style="font-size:18px">Post-audit overlap-excluded analysis</font></b><br><br><font color="#263746" style="font-size:14px">121 episodes | all 11 children | no redraw</font>" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;strokeColor=#278A58;strokeWidth=2.5;fillColor=#EEF8F1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="735" width="405" height="75" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687D8C;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="source" target="episode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#164A6B;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="episode" target="balanced"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#178A98;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="episode" target="higher"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687D8C;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="balanced" target="seeded"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687D8C;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="seeded" target="batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687D8C;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="batch" target="refdev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687D8C;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="refdev" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687D8C;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="audit" target="postref"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687D8C;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="higher" target="exclude"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687D8C;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="exclude" target="frozen"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687D8C;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="frozen" target="frameaudit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687D8C;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="frameaudit" target="postanalysis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="<i><font color="#65798A" style="font-size:13px">The main-batch compliance audit finalizes the scored reference; the original 132 evaluation sample is retained for transparency and the 121 removes known exact-episode overlap without redrawing.</font></i>" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="130" y="960" width="1120" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>